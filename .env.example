# SQLite local persistence. The file is created in the backend working directory.
RAILSYNC_DATABASE_URL=sqlite:///./railsync.db
# Explicit local-only mode. Production requires RAILSYNC_AUTH_MODE=production
# and a 32+ character RAILSYNC_AUTH_SECRET.
RAILSYNC_AUTH_MODE=demo
# OR-Tools runs locally and does not require a paid API key.
# Optional future speech adapter credentials are intentionally not needed for the demo.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENABLED=false
